{
  "schemaVersion": 1,
  "name": "ronitnath-production",
  "maxConcurrency": 1,
  "stages": [
    {
      "id": "eligibility",
      "label": "Candidate on main",
      "kind": "preflight",
      "command": {
        "executable": "pnpm",
        "args": ["tsx", "scripts/delivery.ts", "eligibility"]
      },
      "budget": { "cpuCores": 1, "memoryMiB": 256, "timeoutMs": 60000, "outputBytes": 100000 }
    },
    {
      "id": "static",
      "label": "Static, unit, and PostgreSQL checks",
      "kind": "check",
      "needs": ["eligibility"],
      "command": { "executable": "pnpm", "args": ["delivery:static"] },
      "budget": {
        "cpuCores": 4,
        "memoryMiB": 8192,
        "timeoutMs": 900000,
        "outputBytes": 2000000
      }
    },
    {
      "id": "build",
      "label": "One candidate build graph",
      "kind": "build",
      "needs": ["static"],
      "command": {
        "executable": "pnpm",
        "args": ["tsx", "scripts/delivery.ts", "build"],
        "env": {
          "FLEET_PACKAGES_TOKEN": { "source": "secret", "name": "FLEET_PACKAGES_TOKEN" }
        }
      },
      "budget": {
        "cpuCores": 4,
        "memoryMiB": 8192,
        "timeoutMs": 900000,
        "outputBytes": 2000000
      }
    },
    {
      "id": "artifact",
      "label": "Artifact and compatibility tests",
      "kind": "check",
      "needs": ["build"],
      "command": { "executable": "pnpm", "args": ["delivery:artifact"] },
      "env": { "FLEET_PACKAGES_TOKEN": { "source": "secret", "name": "FLEET_PACKAGES_TOKEN" } },
      "budget": {
        "cpuCores": 4,
        "memoryMiB": 8192,
        "timeoutMs": 1200000,
        "outputBytes": 2000000
      }
    },
    {
      "id": "publish",
      "label": "Publish exact OCI artifacts",
      "kind": "publish",
      "needs": ["artifact"],
      "command": { "executable": "pnpm", "args": ["tsx", "scripts/delivery.ts", "publish"] },
      "mutation": "non-retryable",
      "budget": {
        "cpuCores": 2,
        "memoryMiB": 2048,
        "timeoutMs": 600000,
        "outputBytes": 1000000
      }
    },
    {
      "id": "production-preflight",
      "label": "Pull and checkpoint both replicas",
      "kind": "preflight",
      "needs": ["publish"],
      "command": {
        "executable": "pnpm",
        "args": ["tsx", "scripts/delivery.ts", "production-preflight"],
        "env": { "DEPLOY_SSH_KEY": { "source": "secret", "name": "DEPLOY_SSH_KEY" } }
      },
      "budget": { "cpuCores": 1, "memoryMiB": 512, "timeoutMs": 600000, "outputBytes": 1000000 }
    },
    {
      "id": "migrate",
      "label": "Locked forward migration",
      "kind": "migrate",
      "needs": ["production-preflight"],
      "command": {
        "executable": "pnpm",
        "args": ["tsx", "scripts/delivery.ts", "migrate"],
        "env": { "DEPLOY_SSH_KEY": { "source": "secret", "name": "DEPLOY_SSH_KEY" } }
      },
      "mutation": "non-retryable",
      "budget": {
        "cpuCores": 1,
        "memoryMiB": 1024,
        "timeoutMs": 600000,
        "outputBytes": 1000000
      }
    },
    {
      "id": "nyc",
      "label": "NYC rollout",
      "kind": "rollout",
      "needs": ["migrate"],
      "command": {
        "executable": "pnpm",
        "args": ["tsx", "scripts/delivery.ts", "roll", "nyc"],
        "env": { "DEPLOY_SSH_KEY": { "source": "secret", "name": "DEPLOY_SSH_KEY" } }
      },
      "mutation": "non-retryable",
      "budget": { "cpuCores": 1, "memoryMiB": 512, "timeoutMs": 300000, "outputBytes": 1000000 }
    },
    {
      "id": "sfo",
      "label": "SFO rollout",
      "kind": "rollout",
      "needs": ["nyc"],
      "command": {
        "executable": "pnpm",
        "args": ["tsx", "scripts/delivery.ts", "roll", "sfo"],
        "env": { "DEPLOY_SSH_KEY": { "source": "secret", "name": "DEPLOY_SSH_KEY" } }
      },
      "mutation": "non-retryable",
      "budget": { "cpuCores": 1, "memoryMiB": 512, "timeoutMs": 300000, "outputBytes": 1000000 }
    },
    {
      "id": "acceptance",
      "label": "Public production acceptance",
      "kind": "acceptance",
      "needs": ["sfo"],
      "command": {
        "executable": "pnpm",
        "args": ["tsx", "scripts/delivery.ts", "acceptance"],
        "env": {
          "DELIVERY_INGEST_TOKEN": { "source": "secret", "name": "DELIVERY_INGEST_TOKEN" }
        }
      },
      "attempts": 3,
      "retryDelayMs": 3000,
      "budget": { "cpuCores": 1, "memoryMiB": 512, "timeoutMs": 120000, "outputBytes": 1000000 }
    }
  ]
}
