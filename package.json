{
  "name": "ronitnath",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "tsx runtime/supervisor.ts",
    "build": "next build && pnpm runtime:build",
    "runtime:build": "tsup runtime/supervisor.ts runtime/http.ts runtime/worker.ts scripts/mail-intents.ts --format esm --out-dir dist-runtime --clean --external next --external @dbos-inc/dbos-sdk --external pg --external drizzle-orm --external nodemailer --external @isoastra/fleet-events --external @isoastra/fleet-notifications --external @isoastra/fleet-runtime --external @isoastra/fleet-workflows",
    "start": "node dist-runtime/runtime/supervisor.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:runtime": "pnpm build && node test/runtime-integration.mjs",
    "gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:up": "docker compose -f compose.dev.yaml up -d",
    "db:down": "docker compose -f compose.dev.yaml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:workflow:migrate": "tsx scripts/migrate-workflows.ts",
    "db:migrate:all": "pnpm db:migrate && pnpm db:workflow:migrate",
    "db:load-sky": "node scripts/load-sky.mjs",
    "e2e": "pnpm build && pnpm e2e:prepared",
    "e2e:prepared": "node test/playwright-isolated.mjs",
    "seed:operator": "tsx scripts/seed-operator.ts",
    "migrate:identity": "tsx scripts/migrate-identity.ts",
    "import:export": "tsx scripts/import-export.ts",
    "mail:intents": "node dist-runtime/scripts/mail-intents.mjs",
    "acceptance:local": "sh scripts/accept-dbos-local.sh"
  },
  "dependencies": {
    "@isoastra/fleet-configured": "0.1.3",
    "@isoastra/fleet-events": "file:vendor/isoastra-fleet-events-0.2.3.tgz",
    "@isoastra/fleet-gates": "0.1.3",
    "@isoastra/fleet-notifications": "file:vendor/isoastra-fleet-notifications-0.1.0.tgz",
    "@isoastra/fleet-identity": "0.1.1",
    "@isoastra/fleet-ids": "0.1.1",
    "@isoastra/fleet-runtime": "file:vendor/isoastra-fleet-runtime-0.0.0.tgz",
    "@isoastra/fleet-workflows": "file:vendor/isoastra-fleet-workflows-0.0.0.tgz",
    "@dbos-inc/dbos-sdk": "4.27.6",
    "@isoastra/grid-core": "0.1.0",
    "@isoastra/grid-next": "0.1.0",
    "@isoastra/grid-react": "0.1.0",
    "@node-rs/argon2": "^2.2.0",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "next": "15.5.25",
    "nodemailer": "^10.0.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dotenv": "17.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "overrides": {
      "@isoastra/fleet-events": "file:vendor/isoastra-fleet-events-0.2.3.tgz",
      "@isoastra/fleet-workflows": "file:vendor/isoastra-fleet-workflows-0.0.0.tgz"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}
