{
  "name": "ronitnath",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "delivery:workflow": "tsx scripts/generate-delivery-workflow.ts",
    "delivery:workflow:check": "tsx scripts/generate-delivery-workflow.ts --check",
    "delivery:static": "tsx scripts/delivery.ts static",
    "delivery:artifact": "tsx scripts/delivery.ts artifact",
    "delivery:cleanup": "tsx scripts/delivery.ts cleanup",
    "db:up": "docker compose -f compose.dev.yaml up -d",
    "db:down": "docker compose -f compose.dev.yaml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:load-sky": "node scripts/load-sky.mjs",
    "e2e": "playwright test",
    "seed:operator": "tsx scripts/seed-operator.ts",
    "migrate:identity": "tsx scripts/migrate-identity.ts",
    "import:export": "tsx scripts/import-export.ts"
  },
  "dependencies": {
    "@isoastra/fleet-configured": "0.1.3",
    "@isoastra/fleet-delivery": "0.1.1",
    "@isoastra/fleet-events": "0.2.3",
    "@isoastra/fleet-gates": "0.1.3",
    "@isoastra/fleet-identity": "0.1.1",
    "@isoastra/fleet-ids": "0.1.1",
    "@isoastra/grid-core": "0.1.0",
    "@isoastra/grid-next": "0.1.0",
    "@isoastra/grid-react": "0.1.0",
    "@node-rs/argon2": "^2.2.0",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "next": "15.5.25",
    "nodemailer": "^10.0.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dotenv": "17.2.4",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}
