# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Local hiqlite / SQLite state from `cargo run` (see config.toml db_path)
data/

# Local secrets (e.g. .env.claude holds the local admin credential). The app
# itself reads no .env: sessions are opaque DB-backed tokens, so there is no
# cookie-signing secret to keep.
.env
.env.*

# Cargo.lock is deliberately COMMITTED: this is a deployed application, and both
# the `cargo test --locked` gate and the release image build have nothing to lock
# against without it.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
