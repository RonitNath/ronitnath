# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock is deliberately COMMITTED: this is a deployed application, and both
# the `cargo test --locked` gate and the release image build have nothing to lock
# against without it.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
