# Cargo build output.
target/

# trunk bundle output, one per Leptos CSR crate.
crates/*/dist/

# Local hiqlite / SQLite state from `cargo run` (see config.toml db_path).
data/

# Local secrets. The app itself reads no .env: sessions are opaque DB-backed
# tokens, so there is no cookie-signing secret to keep.
.env
.env.*

# Cargo.lock is deliberately COMMITTED: this is a deployed application, and both
# the `cargo test --locked` gate and the release image build have nothing to lock
# against without it.

# rustfmt backups.
**/*.rs.bk

# Playwright.
end2end/test-results/
node_modules/

# Python bytecode from tools/.
__pycache__/
