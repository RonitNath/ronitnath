# rn-site — local switches, read from the working directory by a DEBUG build
# only (`crates/server/src/main.rs`). Copy it and edit the copy:
#
#     cp .env.example .env
#
# `.env` is ignored by git and must stay that way; nothing here is a secret and
# nothing here should become one. A variable already set in the environment
# wins over this file, so `RN_SITE__DEV=1 cargo run` needs no file at all.
#
# Everything is `RN_SITE__<field>`, matching `AppConfig` — the same contract
# deploy/compose.yaml uses.

# The developer sign-in: a second button under the sign-in form that opens a
# real session as this deployment's platform operator, without a password. It
# invents the operator (dev-operator@example.invalid) if the database has none.
#
# Two gates, and this is the weaker one. The route, its handler and the kernel
# entry behind it are `#[cfg(debug_assertions)]`, so a release binary contains
# none of it and this variable turns nothing on there. It is also refused
# unless the process is in dev mode.
#RN_SITE__DEV=1

# The OpenID Provider's issuer, and the key its signing keys are sealed under.
#
# The issuer is `iss` exactly — every relying party compares it byte for byte —
# and the default is the address `just run-dev` serves on, so a local RP works
# without either of these. Set the sealing key when you want the signing keys
# already in the database to open after a restart: without it a dev process
# mints an ephemeral one and warns, which is what a disposable-dev database is.
# 64 lowercase hex characters. It is NOT the id key: that one names rows and
# this one forges identity.
#RN_SITE__PUBLIC_ORIGIN=http://127.0.0.1:3004
#RN_SITE__OIDC_KEY=0f0e0d0c0b0a090807060504030201000f0e0d0c0b0a09080706050403020100
#RN_SITE__PUBLIC_NAME=Ronit Nath

# The rest of AppConfig, at its checked-in defaults. Uncomment to move one.
#RN_SITE__MODE=dev
#RN_SITE__ADDR=127.0.0.1:3004
#RN_SITE__DB_PATH=data/db.sqlite
#RN_SITE__STATIC_DIR=static
#RN_SITE__BOOTSTRAP_OPERATOR_EMAIL=you@example.invalid
