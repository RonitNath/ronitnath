# Local dev: compose.dev.yaml serves this on 127.0.0.1:5433.
# Production dials the per-node HAProxy in front of Patroni: 127.0.0.1:5000.
DATABASE_URL=postgres://ronitnath:ronitnath@127.0.0.1:5433/ronitnath

# Public-id codec key: exactly 32 hex characters (AES-128).
# openssl rand -hex 16
ID_KEY=00112233445566778899aabbccddeeff

PUBLIC_ORIGIN=http://localhost:3000

# Sessions: opaque 256-bit tokens stored as SHA-256, 30-day sliding.
SESSION_COOKIE=rn_session
SESSION_TTL_DAYS=30

# ZITADEL at auth.isoastra.com; the callback accepts only the allowlisted email.
OIDC_ISSUER=https://auth.isoastra.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback
OIDC_ALLOWLIST=ronit@isoastra.com

# useSend SMTP, e.g. smtp://user:pass@host:587. Unset in dev: mail is logged
# to stdout and written to .mail/<timestamp>.eml.
SMTP_URL=
# Preferred in production: the fleet mailer's REST API (mail.isoastra.com).
# When both are set, the API wins over SMTP_URL.
USESEND_API_URL=
USESEND_API_KEY=
MAIL_FROM=Ronit Nath <no-reply@ronitnath.com>
# Testing only: a recipient the transport must refuse ("1" = all of them).
MAIL_FAIL=

# Set at image build from the jj/git commit; /healthz reports it.
APP_VERSION=dev

# SignInAs (operator impersonation). `off` removes the command entirely: the
# control is not drawn and the action declines. Anything else leaves it on.
RN_IMPERSONATION=on
