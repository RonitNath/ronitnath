{
  "schemaVersion": 3,
  "name": "ronitnath",
  "sensitivity": "sensitive",
  "services": [
    {
      "id": "database",
      "kind": "postgres",
      "command": { "executable": "docker", "args": ["compose", "-f", "compose.dev.yaml", "up", "db"], "inheritEnv": ["PATH", "HOME", "DOCKER_HOST", "DOCKER_CONFIG", "XDG_RUNTIME_DIR"] },
      "readiness": { "kind": "command", "command": { "executable": "docker", "args": ["compose", "-f", "compose.dev.yaml", "exec", "-T", "db", "pg_isready", "-U", "ronitnath", "-d", "ronitnath"], "inheritEnv": ["PATH", "HOME", "DOCKER_HOST", "DOCKER_CONFIG", "XDG_RUNTIME_DIR"] } },
      "budget": { "cpuCores": 1, "memoryMiB": 1024, "timeoutMs": 60000 },
      "inputs": ["compose.dev.yaml", "drizzle/"],
      "persistent": true,
      "portEnvironment": "DEV_DB_PORT",
      "resetCommand": { "executable": "docker", "args": ["compose", "-f", "compose.dev.yaml", "down", "--volumes"], "inheritEnv": ["PATH", "HOME", "DOCKER_HOST", "DOCKER_CONFIG", "XDG_RUNTIME_DIR"] }
    },
    {
      "id": "web",
      "kind": "http",
      "dependsOn": ["database"],
      "command": {
        "executable": "pnpm",
        "args": ["dev"],
        "env": {
          "DATABASE_URL": { "source": "literal", "value": "postgres://ronitnath:ronitnath@127.0.0.1:${service.database.port}/ronitnath" },
          "AUTH_SECRET": { "source": "literal", "value": "local-auth-${environment.id}" },
          "ID_KEY": { "source": "literal", "value": "11111111111111111111111111111111" }
        },
        "inheritEnv": ["PATH", "HOME", "LANG", "TZ"]
      },
      "readiness": { "kind": "http", "path": "/healthz", "timeoutMs": 60000 },
      "budget": { "cpuCores": 2, "memoryMiB": 2048, "timeoutMs": 60000 },
      "inputs": ["src/", "public/", "next.config.ts"],
      "configReferences": ["homepage-copy", "announcement"]
    }
  ],
  "profiles": {
    "local": { "mode": "local", "persistent": false, "ttlSeconds": null, "fixture": "synthetic", "promotion": "none" },
    "semilocal": { "mode": "semilocal", "persistent": false, "ttlSeconds": 1800, "ingressDomain": "rdndev.com", "fixture": "synthetic", "promotion": "none" },
    "preview": { "mode": "preview", "persistent": false, "ttlSeconds": 86400, "ingressDomain": "rdndev.com", "fixture": "synthetic", "promotion": "none" },
    "staging": { "mode": "staging", "persistent": true, "ttlSeconds": null, "ingressDomain": "rdndev.com", "fixture": "synthetic", "promotion": "none" },
    "production": { "mode": "production", "persistent": true, "ttlSeconds": null, "promotion": "automatic" }
  },
  "integrations": [],
  "exposures": [
    { "id": "browser", "service": "web", "kind": "browser", "path": "/", "authentication": "environment" },
    { "id": "delivery-events", "service": "web", "kind": "webhook", "path": "/api/delivery/events", "authentication": "application" }
  ],
  "checks": [
    { "id": "types", "profile": "feedback", "command": { "executable": "pnpm", "args": ["typecheck"] }, "inputs": ["src/", "scripts/", "*.json"], "risk": "ordinary" },
    { "id": "unit", "profile": "feedback", "command": { "executable": "pnpm", "args": ["test"] }, "inputs": ["src/", "scripts/"], "risk": "ordinary" },
    { "id": "release", "profile": "release", "command": { "executable": "pnpm", "args": ["delivery:static"] }, "risk": "policy", "always": true },
    { "id": "migration-compatibility", "profile": "release", "command": { "executable": "pnpm", "args": ["delivery:artifact"] }, "inputs": ["drizzle/", "delivery.migrations.json"], "risk": "migration", "always": true }
  ],
  "migrations": ["drizzle/", "delivery.migrations.json"],
  "fixtures": [
    {
      "name": "synthetic",
      "command": {
        "executable": "pnpm",
        "args": ["db:migrate"],
        "env": {
          "DATABASE_URL": {
            "source": "literal",
            "value": "postgres://ronitnath:ronitnath@127.0.0.1:${service.database.port}/ronitnath"
          }
        },
        "inheritEnv": ["PATH", "HOME", "LANG", "TZ"]
      },
      "allowedModes": ["local", "semilocal", "preview", "staging"]
    }
  ]
}
